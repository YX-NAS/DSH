DSH_AUTH_PUBLIC_ORIGIN=https://dsh.example.com
DSH_AUTH_USERNAME=replace-me
DSH_AUTH_PASSWORD_HASH=replace-with-scrypt-v1-hash
DSH_AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
DSH_AUTH_HOST=127.0.0.1
DSH_AUTH_PORT=3081
DSH_AUTH_SESSION_TTL_SECONDS=43200
DSH_AUTH_MAX_SESSIONS=1000
DSH_AUTH_LOGIN_WINDOW_SECONDS=900
DSH_AUTH_LOGIN_MAX_FAILURES=5
DSH_AUTH_LOGIN_MAX_BUCKETS=10000
