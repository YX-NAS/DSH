server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dsh.example.com;

    ssl_certificate /etc/letsencrypt/live/dsh.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dsh.example.com/privkey.pem;

    location = /_auth_check {
        internal;
        proxy_pass http://127.0.0.1:3081/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host dsh.example.com;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-Host $host;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-Origin $http_origin;
        proxy_set_header X-Original-Sec-Fetch-Site $http_sec_fetch_site;
    }

    location ~ ^/(login|logout)$ {
        proxy_pass http://127.0.0.1:3081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
    }

    location @login_redirect {
        return 302 /login?returnTo=$uri;
    }

    # Authenticated model configuration calls receive the loopback authority
    # required by Harness. Server-desktop methods are intentionally absent.
    location ~ ^/api/(settings\.(describe|update|replace|mutate)|credentials\.(describe|set|unset)|llm\.discoverModels)$ {
        auth_request /_auth_check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:3080;
        proxy_set_header Origin http://127.0.0.1:3080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_request /_auth_check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</body>' '<a href="/logout" style="position:fixed;right:18px;bottom:18px;z-index:99999;padding:9px 13px;border-radius:10px;background:#34353b;color:#fff;text-decoration:none;font:14px system-ui">\u9000\u51fa\u767b\u5f55</a></body>';
    }
}
